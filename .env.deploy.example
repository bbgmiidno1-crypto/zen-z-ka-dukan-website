# Environment for docker compose on the Oracle Always Free VM.
# Copy to .env (same folder as docker-compose.yml) and fill in real values:
#
#   cp .env.deploy.example .env
#   openssl rand -hex 32        # use for SESSION_SECRET
#   openssl rand -hex 24        # use for ADMIN_BOOTSTRAP_TOKEN
#   chmod 600 .env
#
# Never commit .env to git.

# Your free subdomain, e.g. zen-z-ka-dukan.duckdns.org
SITE_DOMAIN=zen-z-ka-dukan.duckdns.org
# Used for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Secret used to sign customer/admin session cookies. Changing it signs everyone out.
SESSION_SECRET=replace-with-openssl-rand-hex-32
# One-time token for the first /admin/setup — delete the value after the administrator exists.
ADMIN_BOOTSTRAP_TOKEN=replace-with-openssl-rand-hex-24

# Public HTTPS port (80 is redirected to 443 automatically).
HTTP_PORT=80
HTTPS_PORT=443
