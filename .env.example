# Optional server configuration. Do not expose these values to frontend code.
# PORT=3001
# DATA_DIR=/absolute/path/to/persistent/volume
# UPLOAD_DIR=/absolute/path/to/persistent/volume/uploads
# SESSION_SECRET=replace-with-a-long-random-value
# ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
# COOKIE_SECURE=true
# COOKIE_PARTITIONED=true  # HTTPS embedded previews only; normal deployments should leave this off
# PREVIEW_ADMIN_HEADER_SESSION=true  # temporary preview fallback only; never enable on the public store
# API_TARGET=http://127.0.0.1:3001
